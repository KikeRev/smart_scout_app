# ==== Django / Web ====
DJANGO_SECRET_KEY=change-me-in-prod
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
# Example: http://localhost:8000 , https://yourdomain.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# ==== Database ====
# Syntax: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg2://scout:scout@db:5432/scouting

# ==== Redis ====
REDIS_URL=redis://redis:6379/0

# ==== Agent / LLM ====
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# App cross-service URLs
DASHBOARD_HOST=http://web:8000

# ==== Dev only (optional) ====
# Used by docker-compose `web` to auto-create a superuser in dev profile
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin123

